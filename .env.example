# ReefCare API configuration — variable names and safe example values only.
# Never put real secrets here. compose.yaml already sets everything `make up` needs;
# copy this file to .env (git-ignored) only to run the API directly with `go run`.
# Full reference: README.md → "API binary".

# development | test | production
APP_ENV=development
HTTP_ADDR=:4000
# Internal-only Prometheus listener; leave empty to disable. Never expose publicly.
METRICS_ADDR=
# Origin of the site users open (email links point here). https is required in production.
PUBLIC_BASE_URL=http://localhost:4001
# Extra origins allowed to send state-changing requests (comma-separated).
ALLOWED_ORIGINS=
# Reverse proxies whose X-Forwarded-For / X-Request-ID are trusted. Required in production.
TRUSTED_PROXY_CIDRS=
SHUTDOWN_TIMEOUT=30s

DATABASE_URL=postgres://reefcare:reefcare@localhost:4002/reefcare?sslmode=disable
DB_MAX_CONNS=10
DB_CONNECT_TIMEOUT=5s

# Required in production (STARTTLS enforced there). Empty in development: emails are only logged.
SMTP_HOST=localhost
SMTP_PORT=4004
SMTP_USERNAME=
# Secret: set it in the environment or a secret manager, never in a committed file.
SMTP_PASSWORD=
MAIL_FROM="ReefCare <no-reply@reefcare.local>"

# Background jobs (emails, purges, account erasure) run concurrently by this instance.
JOB_WORKERS=4
JOB_POLL_INTERVAL=1s

# Max simultaneous password hashes (64 MiB each); empty = GOMAXPROCS.
ARGON2_MAX_CONCURRENCY=
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=text

# Reef Intelligence: optional LLM narrative (docs/knowledge-engine.md §8). Only "none" exists.
LLM_PROVIDER=none
